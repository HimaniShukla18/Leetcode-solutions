class Solution {
    public ListNode[] splitListToParts(ListNode head, int k) {
        // Step 1: Count length of linked list
        int n = 0;
        ListNode curr = head;
        while (curr != null) {
            n++;
            curr = curr.next;
        }

        // Step 2: Compute base size and extra nodes
        int baseSize = n / k;
        int extra = n % k;

        // Step 3: Split into parts
        ListNode[] result = new ListNode[k];
        curr = head;

        for (int i = 0; i < k; i++) {
            int size = baseSize + (i < extra ? 1 : 0); // distribute extra nodes
            if (size == 0) {
                result[i] = null; // if no nodes left
                continue;
            }

            // Assign head of current part
            result[i] = curr;

            // Traverse size-1 nodes
            for (int j = 1; j < size; j++) {
                if (curr != null) curr = curr.next;
            }

            // Cut the list
            if (curr != null) {
                ListNode nextPart = curr.next;
                curr.next = null;
                curr = nextPart;
            }
        }
        return result;
    }
}
