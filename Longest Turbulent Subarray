class Solution {
    public int maxTurbulenceSize(int[] arr) {
        if (arr.length == 1) return 1;

    int up = 1, down = 1, maxLen = 1;

    for (int i = 1; i < arr.length; i++) {
        if (arr[i] > arr[i -1]) {
            up = down + 1;
            down = 1;
        } else if (arr[i] < arr[i - 1]) {
            down = up + 1;
            up = 1;
        } else {
            up = down = 1;
        }
        maxLen = Math.max(maxLen, Math.max(up, down));
    } 
    return maxLen;

        
    }
}
