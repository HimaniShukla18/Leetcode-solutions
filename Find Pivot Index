class Solution {
    public int pivotIndex(int[] nums) {
        // Step 1: Compute total sum
        int totalSum = 0;
        for (int num : nums) {
            totalSum += num;
        }

        // Step 2: Iterate with left sum
        int leftSum = 0;
        for (int i = 0; i < nums.length; i++) {
            int rightSum = totalSum - leftSum - nums[i];
            if (leftSum == rightSum) {
                return i; // pivot found
            }
            leftSum += nums[i];
        }

        // Step 3: No pivot found
        return -1;
    }
}
